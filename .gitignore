!/scripts/ingest_releases.py
!/scripts/package_assets.py
!/scripts/serve.py
!/tests/test_auth.py
!/tests/test_lua_capture.py
!/tests/test_package_assets.py
!/tests/test_private_http.py
!/tests/test_search.py
!/tests/virtual-command-list.test.mjs
!/web/app.js
!/web/command-links.js
!/web/index.html
!/web/styles.css
!/web/virtual-command-list.js
